      "black-friday-faq": {
        "type": "black-friday-faq",
        "blocks": {
          "question_WwWc9c": {
            "type": "question",
            "settings": {
              "title": "WHEN WILL BLACK FRIDAY ORDERS SHIP?",
              "answer": "Due to high order volumes during our only sale of the year, shipping will take longer than usual. We aim to process orders out ASAP, however, please allow upto 3 weeks and extra time for delivery. Kindly select DHL Express Shipping at checkout for a slightly quicker dispatch."
            }
          },
          "question_9t3zNE": {
            "type": "question",
            "settings": {
              "title": "WHAT IS A PREORDER?",
              "answer": "Preorder allows customers to secure our most wanted pieces before the stock arrives to our warehouse. Preorders are always marked on the website with an estimated delivery date to us - these dates are only estimated and delays can occur. Only place a preorder if you are okay with these terms & conditions. If you purchase other items with your preorder item, they will be shipped together when the pre order arrives. We highly recommend placing 2 separate orders if you prefer to have the in stock styles shipped first."
            }
          },
          "question_pmqAjn": {
            "type": "question",
            "settings": {
              "title": "CAN I CHANGE MY ORDER OR COMBINE MY ORDER?",
              "answer": "Unfortunately, no changes can be made to Black Friday orders once placed. Please ensure you review your shopping carts before placing the order. We are also unable to combine shipping during this time."
            }
          },
          "question_hhqYJd": {
            "type": "question",
            "settings": {
              "title": "MY PREVIOUS ORDER / PREORDER HAS NOT BEEN SHIPPED YET, CAN I CANCEL AND RE-PURCHASE?",
              "answer": "Unfortunately, any previous orders cannot be cancelled."
            }
          },
          "question_7XCP9f": {
            "type": "question",
            "settings": {
              "title": "CAN I RETURN AN ORDER PLACED ON BLACK FRIDAY?",
              "answer": "Yes, you can still return the order following our Returns Policy."
            }
          },
          "question_8UznXz": {
            "type": "question",
            "settings": {
              "title": "WHAT IF AN ITEM I PURCHASE OVERSELLS?",
              "answer": "If an item oversells, we will refund back your original payment method. This can occasionally happen when only one item is left in stock and two customers checkout at the same time."
            }
          },
          "question_Q8nfcN": {
            "type": "question",
            "settings": {
              "title": "IS THERE A FREE SHIPPING THRESHOLD DURING OUR SALE?",
              "answer": "The free shipping threshold has temporarily been turned off. We will be offering a flat rate for Express & Standard Shipping at checkout."
            }
          },
          "question_LMjB6p": {
            "type": "question",
            "settings": {
              "title": "I PURCHASED BEFORE THE SALE, CAN YOU APPLY THE DISCOUNT?",
              "answer": "Noni the label is not obliged to apply the discount to purchases placed outside of the promotional timeframe."
            }
          }
        },
