
{%- if section.settings.enable_coming_soon -%}
  <style>
    {%- if section.settings.hide_storefront_chrome -%}
      #shopify-section-announcement,
      #shopify-section-header,
      #shopify-section-footer,
      #shopify-section-popup { display: none !important; }
      .PageContainer { min-height: 100svh; }
    {%- endif -%}
    #shopify-section-{{ section.id }} {
      --coming-card: {{ section.settings.card_color }};
      --coming-accent: {{ section.settings.accent_color }};
      --coming-text: {{ section.settings.text_color }};
      --coming-field: {{ section.settings.field_color }};
      --coming-field-text: {{ section.settings.field_text_color }};
      --coming-pill: {{ section.settings.pill_color }};
    }
    #shopify-section-{{ section.id }} .ComingSoon {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 100svh;
      padding: clamp(28px, 4vw, 64px) 16px;
      isolation: isolate;
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .ComingSoon__background,
    #shopify-section-{{ section.id }} .ComingSoon__background img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    #shopify-section-{{ section.id }} .ComingSoon__background { z-index: -1; }
    #shopify-section-{{ section.id }} .ComingSoon__background img {
      display: block;
      object-fit: cover;
      object-position: center center;
    }
    #shopify-section-{{ section.id }} .ComingSoon__card {
      position: relative;
      box-sizing: border-box;
      container-type: inline-size;
      width: min(100%, 670px, 62svh);
      aspect-ratio: 700 / 1040;
      color: var(--coming-text);
      text-align: center;
      filter: drop-shadow(0 8px 15px rgba(87, 45, 34, .12));
    }
    #shopify-section-{{ section.id }} .ComingSoon__cloud {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
    #shopify-section-{{ section.id }} .ComingSoon__content {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 11.8cqw 12.5cqw 11.5cqw;
      box-sizing: border-box;
      min-width: 0;
    }
    #shopify-section-{{ section.id }} .ComingSoon__eyebrow,
    #shopify-section-{{ section.id }} .ComingSoon__date,
    #shopify-section-{{ section.id }} .ComingSoon__vip,
    #shopify-section-{{ section.id }} .ComingSoon__countdown,
    #shopify-section-{{ section.id }} .ComingSoon__pill,
    #shopify-section-{{ section.id }} .ComingSoon__button {
      font-family: var(--heading-font-family, Arial, sans-serif);
      font-weight: 500;
      text-transform: uppercase;
    }
    #shopify-section-{{ section.id }} .ComingSoon__eyebrow {
      margin: 0;
      font-size: 3.5cqw;
      line-height: 1.35;
      letter-spacing: .27em;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .ComingSoon__rule {
      width: 86%;
      border: 0;
      border-top: 1px solid var(--coming-accent);
      margin: 4cqw 0 3cqw;
      flex: 0 0 auto;
    }
    #shopify-section-{{ section.id }} .ComingSoon__title {
      display: flex;
      flex-direction: column;
      margin: 0 0 3.6cqw;
      font-family:Montserrat, sans-serif, "Times New Roman";
      {% comment %} font-family: Didot, "Bodoni 72", "Times New Roman", serif; {% endcomment %}
      font-size: 20px;
      line-height: .83;
      letter-spacing: -.055em;
      font-weight: 400;
      color: #c3996b;
      text-transform: uppercase;
    }
      #shopify-section-{{ section.id }} .ComingSoon__offer {
        margin: 0 0 3cqw;
        font-family: Didot, "Bodoni 72", "Bodoni MT", "Times New Roman", serif;
        font-size: {{ section.settings.offer_font_size }}px;
        line-height: .95;
        font-weight: 400;
        letter-spacing: -.025em;
        color: {{ section.settings.offer_text_color }};
        text-transform: uppercase;
        font-style: italic;
      }

      #shopify-section-{{ section.id }} .ComingSoon__storewide {
        margin: 0 0 5cqw;
        font-family: Didot, "Bodoni 72", "Times New Roman", serif;
        font-size: 4.5cqw;
        font-weight: 400;
        line-height: 1.3;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--coming-text);
        text-align: center;
      }

      #shopify-section-{{ section.id }} .ComingSoon__two-days {
        margin: 0 0 4cqw;
        font-family: var(--heading-font-family, Arial, sans-serif);
        font-size: 3.45cqw;;
        font-weight: 500;
        line-height: 1.3;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--coming-text);
        text-align: center;
      }

    #shopify-section-{{ section.id }} .ComingSoon__pill {
      width: 100%;
      box-sizing: border-box;
      margin: 0 0 4.5cqw;
      padding: 1.5cqw 3.5cqw;
      border: 1.5px solid var(--coming-accent);
      border-radius: 999px;
      background: var(--coming-pill);
      color: #ae4946;
      font-size: 3.7cqw;
      line-height: 1.25;
      letter-spacing: .12em;
      overflow-wrap: anywhere;
    }
    #shopify-section-{{ section.id }} .ComingSoon__date {
      margin: 0 0 1.5cqw;
      font-size: 3.45cqw;
      line-height: 1.2;
      letter-spacing: .21em;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .ComingSoon__time {
      margin: 0 0 1.1cqw;
      font-family: Didot, "Bodoni 72", "Times New Roman", serif;
      font-weight: 400;
      font-size: 8.2cqw;
      line-height: 1.05;
      letter-spacing: .07em;
      color: var(--coming-accent);
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .ComingSoon__vip {
      margin: 0;
      font-size: 2.8cqw;
      line-height: 1.35;
      letter-spacing: .15em;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .ComingSoon__countdown {
      width: 100%;
      margin: 0 0 3.3cqw;
      font-family: var(--heading-font-family, Arial, sans-serif);
      color: var(--coming-text);
      text-align: center;
      font-variant-numeric: tabular-nums;
    }
    #shopify-section-{{ section.id }} .ComingSoon__countdown-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.75cqw;
      width: 86%;
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .ComingSoon__countdown-unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1cqw;
      min-width: 0;
    }
    #shopify-section-{{ section.id }} .ComingSoon__countdown-value {
      display: grid;
      place-items: center;
      box-sizing: border-box;
      width: 100%;
      min-height: 8.2cqw;
      border: 1px solid var(--coming-accent);
      border-radius: 1.7cqw;
      background: var(--coming-field);
      color: var(--coming-text);
      font-family: Didot, "Bodoni 72", "Times New Roman", serif;
      font-weight: 400;
      font-size: 5.25cqw;
      line-height: 1;
    }
    #shopify-section-{{ section.id }} .ComingSoon__countdown-caption {
      font-size: 2.15cqw;
      font-weight: 500;
      letter-spacing: .09em;
      line-height: 1.1;
    }
    #shopify-section-{{ section.id }} .ComingSoon__divider {
      display: flex;
      width: 86%;
      align-items: center;
      justify-content: center;
      gap: 2.5cqw;
      margin: 1.9cqw 0 2.4cqw;
      color: var(--coming-accent);
    }
    #shopify-section-{{ section.id }} .ComingSoon__divider::before,
    #shopify-section-{{ section.id }} .ComingSoon__divider::after {
      content: "";
      flex: 1;
      border-top: 1px solid currentColor;
    }
    #shopify-section-{{ section.id }} .ComingSoon__heart {
      width: 5cqw;
      height: 5cqw;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
    }
    #shopify-section-{{ section.id }} .ComingSoon__form {
      width: 100%;
      margin: 0;
    }
    #shopify-section-{{ section.id }} .ComingSoon__input,
    #shopify-section-{{ section.id }} .ComingSoon__button {
      box-sizing: border-box;
      display: block;
      width: 100%;
      min-width: 0;
      height: 8.4cqw;
      min-height: 36px;
      border: 1px solid var(--coming-accent);
      border-radius: 999px;
    }
    #shopify-section-{{ section.id }} .ComingSoon__input {
      margin-bottom: 1.9cqw;
      padding: 0 3.6cqw;
      background: var(--coming-field);
      color: var(--coming-text);
      font-family: var(--text-font-family, Arial, sans-serif);
      font-size: 2.9cqw;
      text-align: left;
    }
    #shopify-section-{{ section.id }} .ComingSoon__input::placeholder {
      color: var(--coming-field-text);
      opacity: 1;
    }
    #shopify-section-{{ section.id }} .ComingSoon__button {
      margin-top: 2.5cqw;
      border-color: var(--coming-accent);
      background: var(--coming-accent);
      color: white;
      cursor: pointer;
      font-size: 3.2cqw;
      letter-spacing: .27em;
      transition: background-color .2s ease, color .2s ease;
    }
    #shopify-section-{{ section.id }} .ComingSoon__button:hover {
      color: var(--coming-accent);
      background: var(--coming-card);
    }
    #shopify-section-{{ section.id }} .ComingSoon__input:focus-visible,
    #shopify-section-{{ section.id }} .ComingSoon__button:focus-visible {
      outline: 2px solid var(--coming-text);
      outline-offset: 3px;
    }
    #shopify-section-{{ section.id }} .ComingSoon__honeypot {
      position: absolute !important;
      left: -5000px !important;
    }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .ComingSoon {
        place-items: start center;
        /* Keep the portrait's faces in their own visual band above the opaque card. */
        padding: clamp(300px, 40svh, 400px) 4vw max(7svh, 36px);
      }
      #shopify-section-{{ section.id }} .ComingSoon__background img {
        object-position: center top;
      }
      #shopify-section-{{ section.id }} .ComingSoon__card {
        width: min(100%, 490px);
      }
    }
    /* Keep the card compact on larger phones without reducing the image space. */
    @media screen and (min-width: 430px) and (max-width: 749px) {
      #shopify-section-{{ section.id }} .ComingSoon {
        padding-bottom: 32px;
      }
      #shopify-section-{{ section.id }} .ComingSoon__card {
        width: min(100%, 395px, 50svh);
      }
    }
    /* Tablets: make the complete card fit below the storefront header. */
    @media screen and (min-width: 750px) and (max-width: 1024px) {
      #shopify-section-{{ section.id }} .ComingSoon {
        min-height: min(100svh, 640px);
        padding: 20px 16px;
      }
      #shopify-section-{{ section.id }} .ComingSoon__card {
        width: min(100%, 360px, 46svh);
      }
    }
    @media screen and (max-width: 380px) {
      #shopify-section-{{ section.id }} .ComingSoon { padding-inline: 2vw; }
      #shopify-section-{{ section.id }} .ComingSoon__card { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .ComingSoon__button { transition: none; }
    }
  </style>

  <section class="ComingSoon" aria-labelledby="ComingSoonTitle-{{ section.id }}" {{ section.shopify_attributes }}>
    <picture class="ComingSoon__background" aria-hidden="true">
      {%- if section.settings.mobile_banner != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_banner | image_url: width: 1200 }}">
      {%- else -%}
        <source media="(max-width: 749px)" srcset="{{ 'coming-soon-mobile.jpg' | asset_url }}">
      {%- endif -%}
      {%- if section.settings.desktop_banner != blank -%}
        <img src="{{ section.settings.desktop_banner | image_url: width: 2400 }}" width="{{ section.settings.desktop_banner.width }}" height="{{ section.settings.desktop_banner.height }}" alt="" loading="eager" fetchpriority="high">
      {%- else -%}
        <img src="{{ 'coming-soon-desktop.jpg' | asset_url }}" width="1672" height="941" alt="" loading="eager" fetchpriority="high">
      {%- endif -%}
    </picture>

    <div class="ComingSoon__card">
      <svg class="ComingSoon__cloud" viewBox="0 0 700 1040" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M 68 52 Q 108 0 148 52 Q 188 0 228 52 Q 268 0 308 52 Q 348 0 388 52 Q 428 0 468 52 Q 508 0 548 52 Q 588 0 628 52 C 662 52 671 65 665 83 Q 690 122.5 665 162 Q 690 201.5 665 241 Q 690 280.5 665 320 Q 690 359.5 665 399 Q 690 438.5 665 478 Q 690 517.5 665 557 Q 690 596.5 665 636 Q 690 675.5 665 715 Q 690 754.5 665 794 Q 690 833.5 665 873 Q 690 912.5 665 952 C 673 972 655 990 640 990 Q 588 1032 548 990 Q 508 1032 468 990 Q 428 1032 388 990 Q 348 1032 308 990 Q 268 1032 228 990 Q 188 1032 148 990 Q 108 1032 68 990 C 48 990 34 974 35 952 Q 10 912.5 35 873 Q 10 833.5 35 794 Q 10 754.5 35 715 Q 10 675.5 35 636 Q 10 596.5 35 557 Q 10 517.5 35 478 Q 10 438.5 35 399 Q 10 359.5 35 320 Q 10 280.5 35 241 Q 10 201.5 35 162 Q 10 122.5 35 83 C 29 65 42 52 68 52 Z" fill="var(--coming-card)" stroke="var(--coming-accent)" stroke-width="2"></path>
        <path d="M 68 52 Q 108 0 148 52 Q 188 0 228 52 Q 268 0 308 52 Q 348 0 388 52 Q 428 0 468 52 Q 508 0 548 52 Q 588 0 628 52 C 662 52 671 65 665 83 Q 690 122.5 665 162 Q 690 201.5 665 241 Q 690 280.5 665 320 Q 690 359.5 665 399 Q 690 438.5 665 478 Q 690 517.5 665 557 Q 690 596.5 665 636 Q 690 675.5 665 715 Q 690 754.5 665 794 Q 690 833.5 665 873 Q 690 912.5 665 952 C 673 972 655 990 640 990 Q 588 1032 548 990 Q 508 1032 468 990 Q 428 1032 388 990 Q 348 1032 308 990 Q 268 1032 228 990 Q 188 1032 148 990 Q 108 1032 68 990 C 48 990 34 974 35 952 Q 10 912.5 35 873 Q 10 833.5 35 794 Q 10 754.5 35 715 Q 10 675.5 35 636 Q 10 596.5 35 557 Q 10 517.5 35 478 Q 10 438.5 35 399 Q 10 359.5 35 320 Q 10 280.5 35 241 Q 10 201.5 35 162 Q 10 122.5 35 83 C 29 65 42 52 68 52 Z" transform="translate(350 520) scale(.978 .986) translate(-350 -520)" fill="none" stroke="var(--coming-accent)" stroke-width="1.4"></path>
      </svg>
      <div class="ComingSoon__content">
        <p class="ComingSoon__eyebrow">{{ section.settings.eyebrow| escape }}</p>
        <hr class="ComingSoon__rule">
        <h1 id="ComingSoonTitle-{{ section.id }}" class="ComingSoon__title">
          <span>{{ section.settings.discount | escape }}</span>
          <span>{{ section.settings.scope | escape }}</span>
        </h1>
         {% if section.settings.offer_text != blank %}
          <p class="ComingSoon__offer">
            {{ section.settings.offer_text | escape }}
          </p> 
        {% endif %}
        {% if section.settings.storewide_text != blank %}
        <p class="ComingSoon__storewide">
          {{ section.settings.storewide_text | escape }}
        </p>
      {% endif %}

      {% if section.settings.two_days_text != blank %}
        <p class="ComingSoon__two-days">
          {{ section.settings.two_days_text | escape }}
        </p>
      {% endif %}
        {% if section.settings.duration != blank %}
        <p class="ComingSoon__pill">
          {{ section.settings.duration | escape }}
        </p>
       {% endif %}
        {%- if section.settings.show_countdown and section.settings.countdown_target != blank -%}
          <div class="ComingSoon__countdown" data-coming-countdown data-target="{{ section.settings.countdown_target | escape }}" role="timer" aria-label="Countdown to VIP early access">
            <div class="ComingSoon__countdown-grid">
              <span class="ComingSoon__countdown-unit"><span class="ComingSoon__countdown-value" data-days>00</span><span class="ComingSoon__countdown-caption">DAYS</span></span>
              <span class="ComingSoon__countdown-unit"><span class="ComingSoon__countdown-value" data-hours>00</span><span class="ComingSoon__countdown-caption">HOURS</span></span>
              <span class="ComingSoon__countdown-unit"><span class="ComingSoon__countdown-value" data-minutes>00</span><span class="ComingSoon__countdown-caption">MINS</span></span>
              <span class="ComingSoon__countdown-unit"><span class="ComingSoon__countdown-value" data-seconds>00</span><span class="ComingSoon__countdown-caption">SECS</span></span>
            </div>
          </div>
        {%- endif -%}
        <p class="ComingSoon__date">{{ section.settings.event_date | escape }}</p>
        <p class="ComingSoon__time">{{ section.settings.event_time | escape }}</p>
        <p class="ComingSoon__vip">{{ section.settings.early_access | escape }}</p>
        <div class="ComingSoon__divider" aria-hidden="true">
          <svg class="ComingSoon__heart" viewBox="0 0 24 24"><path d="M12 21C9 16.5 2 12.7 2 7.7 2 4.7 4 3 6.7 3c2.3 0 4 1.5 5.3 3.2C13.3 4.5 15 3 17.3 3 20 3 22 4.7 22 7.7c0 5-7 8.8-10 13.3Z"></path></svg>
        </div>

        <form class="ComingSoon__form" action="https://noniandco.us21.list-manage.com/subscribe/post?u=ad049ae8f1a09f572e8004a95&amp;id=8dbaa6d33e&amp;f_id=00fff7e6f0" method="post" target="_blank">
          {%- if section.settings.show_first_name -%}
            <label class="u-visually-hidden" for="ComingSoonName-{{ section.id }}">First name</label>
            <input id="ComingSoonName-{{ section.id }}" class="ComingSoon__input" type="text" name="FNAME" placeholder="{{ section.settings.first_name_placeholder | escape }}" autocomplete="given-name">
          {%- endif -%}
          <label class="u-visually-hidden" for="ComingSoonEmail-{{ section.id }}">Email address</label>
          <input id="ComingSoonEmail-{{ section.id }}" class="ComingSoon__input" type="email" name="EMAIL" placeholder="{{ section.settings.email_placeholder | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required>
          <input type="hidden" name="tags" value="2982607">
          <div class="ComingSoon__honeypot" aria-hidden="true"><input type="text" name="b_ad049ae8f1a09f572e8004a95_8dbaa6d33e" tabindex="-1" value=""></div>
          <button class="ComingSoon__button" type="submit">{{ section.settings.button_label | escape }}</button>
        </form>
      </div>
    </div>
  </section>

  {%- if section.settings.show_countdown and section.settings.countdown_target != blank -%}
    <script>
      (() => {
        const section = document.getElementById('shopify-section-{{ section.id }}');
        const countdown = section && section.querySelector('[data-coming-countdown]');

        if (!countdown) return;

        const target = Date.parse(countdown.dataset.target);
        if (Number.isNaN(target)) {
          countdown.hidden = true;
          return;
        }

        const parts = {
          days: countdown.querySelector('[data-days]'),
          hours: countdown.querySelector('[data-hours]'),
          minutes: countdown.querySelector('[data-minutes]'),
          seconds: countdown.querySelector('[data-seconds]')
        };
        const second = 1000;
        const minute = second * 60;
        const hour = minute * 60;
        const day = hour * 24;
        let interval;

        const updateCountdown = () => {
          const remaining = Math.max(0, target - Date.now());

          parts.days.textContent = String(Math.floor(remaining / day)).padStart(2, '0');
          parts.hours.textContent = String(Math.floor((remaining % day) / hour)).padStart(2, '0');
          parts.minutes.textContent = String(Math.floor((remaining % hour) / minute)).padStart(2, '0');
          parts.seconds.textContent = String(Math.floor((remaining % minute) / second)).padStart(2, '0');

          if (remaining === 0 && interval) clearInterval(interval);
        };

        updateCountdown();
        interval = setInterval(updateCountdown, second);

        document.addEventListener('shopify:section:unload', (event) => {
          if (event.detail.sectionId === '{{ section.id }}') clearInterval(interval);
        }, { once: true });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

