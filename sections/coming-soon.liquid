{%- if section.settings.enable_coming_soon -%}
  <style>
    {%- if section.settings.hide_storefront_chrome -%}
      #shopify-section-announcement,
      #shopify-section-header,
      #shopify-section-footer,
      #shopify-section-popup { display: none !important; }
      .PageContainer { min-height: 100svh; }
    {%- endif -%}

    #shopify-section-{{ section.id }} {
      --coming-soon-card: {{ section.settings.card_color }};
      --coming-soon-accent: {{ section.settings.accent_color }};
      --coming-soon-text: {{ section.settings.text_color }};
      --coming-soon-field: {{ section.settings.field_color }};
      --coming-soon-field-text: {{ section.settings.field_text_color }};
    }

    #shopify-section-{{ section.id }} .ComingSoon {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      min-height: 100svh;
      padding-block: clamp(48px, 7.8svh, 74px);
      overflow: hidden;
      isolation: isolate;
    }

    #shopify-section-{{ section.id }} .ComingSoon__background,
    #shopify-section-{{ section.id }} .ComingSoon__background img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .ComingSoon__background { z-index: -1; }

    #shopify-section-{{ section.id }} .ComingSoon__background img {
      display: block;
      object-fit: cover;
      object-position: center;
    }

    #shopify-section-{{ section.id }} .ComingSoon__card {
      box-sizing: border-box;
      container-type: inline-size;
      width: min(44.15vw, 78.4svh, 738px);
      aspect-ratio: 738 / 795;
      padding: 3cqw 3cqw 5cqw;
      overflow: hidden;
      border-radius: 3.1cqw;
      background: var(--coming-soon-card);
      color: var(--coming-soon-text);
      text-align: center;
    }

    #shopify-section-{{ section.id }} .ComingSoon__eyebrow,
    #shopify-section-{{ section.id }} .ComingSoon__followers,
    #shopify-section-{{ section.id }} .ComingSoon__date,
    #shopify-section-{{ section.id }} .ComingSoon__alarm,
    #shopify-section-{{ section.id }} .ComingSoon__button {
      font-family: var(--heading-font-family);
      font-style: normal;
      font-weight: 500;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .ComingSoon__eyebrow {
      margin: 0 0 3.4cqw;
      font-size: 3.2cqw;
      line-height: 1.2;
      letter-spacing: .54em;
      text-indent: .54em;
    }

    #shopify-section-{{ section.id }} .ComingSoon__title,
    #shopify-section-{{ section.id }} .ComingSoon__earlyAccess {
      margin: 0;
      color: var(--coming-soon-accent);
      font-family: Didot, "Bodoni 72", "Bodoni MT", "Times New Roman", serif;
      font-style: normal;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .ComingSoon__discount {
      display: block;
      margin-inline: -4cqw;
      font-size: 24cqw;
      line-height: .78;
      letter-spacing: -.055em;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .ComingSoon__sitewide {
      display: block;
      margin: 3.2cqw 0 3.6cqw;
      font-size: 8.8cqw;
      line-height: 1;
      letter-spacing: .32em;
      text-indent: .32em;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .ComingSoon__duration {
      margin: 0;
      padding: 2.15cqw 0 2.05cqw;
      border-block: 1px solid var(--coming-soon-accent);
      color: var(--coming-soon-accent);
      font-family: Didot, "Bodoni 72", "Bodoni MT", "Times New Roman", serif;
      font-size: 5.2cqw;
      font-weight: 400;
      line-height: 1;
      letter-spacing: .2em;
      text-indent: .2em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .ComingSoon__followers {
      margin: 3.05cqw 0 1.2cqw;
      font-size: 2.7cqw;
      line-height: 1.2;
      letter-spacing: .47em;
      text-indent: .47em;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .ComingSoon__heart {
      display: block;
      width: 4.5cqw;
      height: auto;
      margin: 0 auto;
      color: var(--coming-soon-accent);
    }

    #shopify-section-{{ section.id }} .ComingSoon__earlyAccess {
      margin: 1.25cqw -3cqw 2.45cqw;
      font-size: 7.2cqw;
      font-style: italic;
      line-height: 1.05;
      letter-spacing: -.045em;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .ComingSoon__date {
      margin: 0 0 1.6cqw;
      font-size: 3.05cqw;
      line-height: 1.2;
      letter-spacing: .4em;
      text-indent: .4em;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .ComingSoon__alarm {
      margin: 0;
      font-size: 2.35cqw;
      line-height: 1.2;
      letter-spacing: .48em;
      text-indent: .48em;
    }

    #shopify-section-{{ section.id }} .ComingSoon__alarmRow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.8cqw;
      margin-bottom: 3.45cqw;
    }

    #shopify-section-{{ section.id }} .ComingSoon__alarmRow .ComingSoon__heart {
      flex: 0 0 auto;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .ComingSoon__form { margin: 0; }

    #shopify-section-{{ section.id }} .ComingSoon__input,
    #shopify-section-{{ section.id }} .ComingSoon__button {
      box-sizing: border-box;
      display: block;
      width: 100%;
      min-width: 0;
      height: 9.9cqw;
      border-radius: 2.5cqw;
    }

    #shopify-section-{{ section.id }} .ComingSoon__input {
      padding: 0 4cqw;
      border: 1px solid var(--coming-soon-field-text);
      outline: none;
      background: var(--coming-soon-field);
      color: var(--coming-soon-text);
      font-family: var(--text-font-family);
      font-size: 3.2cqw;
      line-height: 1;
      transition: border-color .2s ease, box-shadow .2s ease;
    }

    #shopify-section-{{ section.id }} .ComingSoon__input::placeholder {
      color: var(--coming-soon-field-text);
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .ComingSoon__input:focus {
      border-color: var(--coming-soon-accent);
      box-shadow: 0 0 0 2px rgba(191, 116, 125, .24);
    }

    #shopify-section-{{ section.id }} .ComingSoon__button {
      margin-top: 2.4cqw;
      padding: 0 3cqw;
      border-radius: 999px;
      border: 1px solid var(--coming-soon-accent);
      background: var(--coming-soon-accent);
      color: #fffaf6;
      cursor: pointer;
      font-size: 2.8cqw;
      line-height: 1;
      letter-spacing: .42em;
      text-indent: .42em;
      transition: background-color .2s ease, color .2s ease;
    }

    #shopify-section-{{ section.id }} .ComingSoon__button:hover {
      background: transparent;
      color: var(--coming-soon-accent);
    }

    #shopify-section-{{ section.id }} .ComingSoon__button:focus-visible,
    #shopify-section-{{ section.id }} .ComingSoon__input:focus-visible {
      outline: 2px solid var(--coming-soon-text);
      outline-offset: 3px;
    }

    #shopify-section-{{ section.id }} .ComingSoon__honeypot {
      position: absolute !important;
      left: -5000px !important;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .ComingSoon {
        align-items: flex-start;
        padding-top: 24.05svh;
        padding-bottom: calc(11.5svh + env(safe-area-inset-bottom, 0px));
      }

      #shopify-section-{{ section.id }} .ComingSoon__card {
        width: 66.4vw;
        min-height: 94.3vw;
        aspect-ratio: auto;
        padding: 5cqw 4cqw 3cqw;
        border-radius: 30px;
      }

      #shopify-section-{{ section.id }} .ComingSoon__eyebrow {
        margin-bottom: 7.4cqw;
        font-size: 3.65cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__discount {
        margin-inline: -3cqw;
        font-size: 22.3cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__sitewide {
        margin: 4.6cqw 0 5.3cqw;
        font-size: 9.3cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__duration {
        padding-block: 3cqw;
        font-size: 5.45cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__followers {
        margin: 4.3cqw -2cqw 2.2cqw;
        font-size: 3.15cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__heart { width: 5cqw; }

      #shopify-section-{{ section.id }} .ComingSoon__earlyAccess {
        margin: 4.1cqw -4cqw 4.6cqw;
        font-size: 7.75cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__date {
        margin-bottom: 2.9cqw;
        font-size: 3.25cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__alarm {
        font-size: 2.65cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__alarmRow {
        flex-direction: column;
        gap: 2.2cqw;
        margin-bottom: 4.6cqw;
      }

      #shopify-section-{{ section.id }} .ComingSoon__input,
      #shopify-section-{{ section.id }} .ComingSoon__button {
        height: 13.4cqw;
        min-height: 44px;
        border-radius: 16px;
      }

      #shopify-section-{{ section.id }} .ComingSoon__input { font-size: 4.3cqw; }

      #shopify-section-{{ section.id }} .ComingSoon__button {
        margin-top: 2.7cqw;
        border-radius: 999px;
        font-size: 3.9cqw;
      }
    }

    @media screen and (max-width: 749px) and (max-height: 620px) {
      #shopify-section-{{ section.id }} .ComingSoon {
        min-height: 700px;
        padding-top: 120px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .ComingSoon__input,
      #shopify-section-{{ section.id }} .ComingSoon__button { transition: none; }
    }
  </style>

  <section class="ComingSoon" aria-labelledby="ComingSoonTitle-{{ section.id }}" {{ section.shopify_attributes }}>
    <picture class="ComingSoon__background" aria-hidden="true">
      {%- if section.settings.mobile_banner != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_banner | image_url: width: 1600 }}" width="{{ section.settings.mobile_banner.width }}" height="{{ section.settings.mobile_banner.height }}">
      {%- else -%}
        <source media="(max-width: 749px)" srcset="{{ 'coming-soon-mobile.jpg' | asset_url }}">
      {%- endif -%}
      {%- if section.settings.desktop_banner != blank -%}
        <img src="{{ section.settings.desktop_banner | image_url: width: 2400 }}" width="{{ section.settings.desktop_banner.width }}" height="{{ section.settings.desktop_banner.height }}" alt="" loading="eager" fetchpriority="high">
      {%- else -%}
        <img src="{{ 'coming-soon-desktop.jpg' | asset_url }}" width="1672" height="941" alt="" loading="eager" fetchpriority="high">
      {%- endif -%}
    </picture>

    <div class="ComingSoon__card">
      <p class="ComingSoon__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="ComingSoonTitle-{{ section.id }}" class="ComingSoon__title">
        <span class="ComingSoon__discount">{{ section.settings.discount | escape }}</span>
        <span class="ComingSoon__sitewide">{{ section.settings.scope | escape }}</span>
      </h1>
      <p class="ComingSoon__duration">{{ section.settings.duration | escape }}</p>
      <p class="ComingSoon__followers">{{ section.settings.celebration | escape }}</p>
      <svg class="ComingSoon__heart" viewBox="0 0 24 29" aria-hidden="true"><path d="M12 27C10.4 22.3 2 15.4 2 7.8 2 4.5 4 2 7 2c2.5 0 4.1 1.7 5 4.1C12.9 3.7 14.5 2 17 2c3 0 5 2.5 5 5.8 0 7.6-8.4 14.5-10 19.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <h2 class="ComingSoon__earlyAccess">{{ section.settings.early_access | escape }}</h2>
      <p class="ComingSoon__date">{{ section.settings.event_date | escape }} &nbsp;&bull;&nbsp; {{ section.settings.event_time | escape }}</p>
      <div class="ComingSoon__alarmRow">
        <p class="ComingSoon__alarm">{{ section.settings.alarm_text | escape }}</p>
        <svg class="ComingSoon__heart" viewBox="0 0 24 29" aria-hidden="true"><path d="M12 27C10.4 22.3 2 15.4 2 7.8 2 4.5 4 2 7 2c2.5 0 4.1 1.7 5 4.1C12.9 3.7 14.5 2 17 2c3 0 5 2.5 5 5.8 0 7.6-8.4 14.5-10 19.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>

      <form class="ComingSoon__form" action="https://noniandco.us21.list-manage.com/subscribe/post?u=ad049ae8f1a09f572e8004a95&amp;id=8dbaa6d33e&amp;f_id=00fff7e6f0" method="post" target="_blank">
        <label class="u-visually-hidden" for="ComingSoonEmail-{{ section.id }}">Email address</label>
        <input id="ComingSoonEmail-{{ section.id }}" class="ComingSoon__input" type="email" name="EMAIL" value="" placeholder="{{ section.settings.email_placeholder | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required>
        <input type="hidden" name="tags" value="2982607">
        <div class="ComingSoon__honeypot" aria-hidden="true"><input type="text" name="b_ad049ae8f1a09f572e8004a95_8dbaa6d33e" tabindex="-1" value=""></div>
        <button class="ComingSoon__button" type="submit">{{ section.settings.button_label | escape }}</button>
      </form>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "checkbox", "id": "enable_coming_soon", "label": "Enable coming soon page", "default": true },
    { "type": "checkbox", "id": "hide_storefront_chrome", "label": "Hide announcement, header and footer", "default": false },
    { "type": "header", "content": "Background images" },
    { "type": "image_picker", "id": "desktop_banner", "label": "Desktop background" },
    { "type": "image_picker", "id": "mobile_banner", "label": "Mobile background" },
    { "type": "header", "content": "Campaign content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BE THE FIRST TO SHOP" },
    { "type": "text", "id": "discount", "label": "Discount", "default": "20% OFF" },
    { "type": "text", "id": "scope", "label": "Sale scope", "default": "SITEWIDE" },
    { "type": "text", "id": "duration", "label": "Duration", "default": "FOR 55 MINUTES ONLY" },
    { "type": "text", "id": "celebration", "label": "Celebration text", "default": "CELEBRATING 550K FOLLOWERS" },
    { "type": "text", "id": "early_access", "label": "Early access message", "default": "Get 10 Minutes Early Access" },
    { "type": "text", "id": "event_date", "label": "Event date", "default": "24 SEPTEMBER" },
    { "type": "text", "id": "event_time", "label": "Event time", "default": "11AM NZST" },
    { "type": "text", "id": "alarm_text", "label": "Reminder text", "default": "SET YOUR ALARMS" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "GET EARLY ACCESS" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#faf2ec" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#bf747d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4d393a" },
    { "type": "color", "id": "field_color", "label": "Email field", "default": "#fcf8f5" },
    { "type": "color", "id": "field_text_color", "label": "Email field text and border", "default": "#9b8f90" }
  ],
  "presets": [{ "name": "Coming soon" }]
}
{% endschema %}
